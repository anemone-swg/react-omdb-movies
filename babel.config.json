{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": {
          "node": "current"
        }
      }
    ],
    "@babel/preset-typescript",
    [
      "@babel/preset-react",
      {
        "runtime": "automatic"
      }
    ]
  ],
  "plugins": [
    [
      "./babel/babelRemovePropsPlugin.js",
      {
        "props": [
          "data-testid"
        ]
      }
    ]
  ]
}