{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": {
          "node": "current"
        }
      }
    ],
    "@babel/preset-typescript",
    [
      "@babel/preset-react",
      {
        "runtime": "automatic"
      }
    ]
  ],
  "env": {
    "production": {
      "plugins": [
        [
          "./babel/babelRemovePropsPlugin.js",
          {
            "props": [
              "data-testid",
              "debug"
            ]
          }
        ]
      ]
    }
  }
}